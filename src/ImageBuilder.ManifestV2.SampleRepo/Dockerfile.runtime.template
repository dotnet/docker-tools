{% assign runtime = release.runtime -%}
{% assign url = runtime.downloads[rid].downloadUrl | replace: runtime.buildVersion, "$dotnet_version" -%}
{% assign checksumUrl = runtime.downloads[rid].sha512Url | replace: runtime.buildVersion, "$dotnet_version" -%}
{% assign file = url | split: "/" | last -%}
{% assign checksumFile = checksumUrl | split: "/" | last -%}
ARG REPO=mcr.microsoft.com/dotnet/runtime-deps

# Installer image
FROM {{ arch }}/buildpack-deps:{{ installerOs }}-curl AS installer

# Retrieve .NET Runtime
RUN dotnet_version={{ runtime.buildVersion }} \
    && curl --fail --show-error --location \
        --remote-name {{ url }} \
        --remote-name {{ checksumUrl }} \
    && sha512sum -c {{ checksumFile }} \
    && mkdir --parents /dotnet \
    && tar --gzip --extract --no-same-owner --file {{ file }} --directory /dotnet \
    && rm \
        {{ file }} \
        {{ checksumFile }}


# .NET runtime image
FROM $REPO:{{ runtime.productVersion }}-{{ os.name }}-{{ arch }}

# .NET Runtime version
ENV DOTNET_VERSION={{ runtime.buildVersion }}

COPY --from=installer ["/dotnet", "/usr/share/dotnet"]

RUN ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet
