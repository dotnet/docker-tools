{
  "registry": "mcr.microsoft.com",
  "variables": {
    "TagPrefix": "",
    "LatestTag": "latest"
  },
  "repos": [
    {
      "id": "image-builder",
      "name": "dotnet-buildtools/image-builder",
      "images": [
        {
          "sharedTags": {
            "$(LatestTag)": {},
            "$(TagPrefix)$(UniqueId)": {}
          },
          "platforms": [
            {
              "dockerfile": "Dockerfile.linux",
              "os": "linux",
              "osVersion": "azurelinux",
              "tags": {
                "$(TagPrefix)linux-amd64": {},
                "$(TagPrefix)linux-amd64-$(UniqueId)": {}
              }
            },
            {
              "architecture": "arm64",
              "dockerfile": "Dockerfile.linux",
              "os": "linux",
              "osVersion": "azurelinux",
              "tags": {
                "$(TagPrefix)linux-arm64": {},
                "$(TagPrefix)linux-arm64-$(UniqueId)": {}
              },
              "variant": "v8"
            },
            {
              "buildArgs": {
                "WINDOWS_BASE": "servercore:ltsc2016-amd64",
                "WINDOWS_SDK": "nanoserver-1809"
              },
              "dockerfile": "Dockerfile.windows",
              "os": "windows",
              "osVersion": "windowsservercore-ltsc2019",
              "tags": {
                "$(TagPrefix)windowsservercore-ltsc2016-amd64": {},
                "$(TagPrefix)windowsservercore-ltsc2016-amd64-$(UniqueId)": {}
              }
            },
            {
              "buildArgs": {
                "WINDOWS_BASE": "nanoserver:1809-amd64",
                "WINDOWS_SDK": "nanoserver-1809"
              },
              "dockerfile": "Dockerfile.windows",
              "os": "windows",
              "osVersion": "nanoserver-1809",
              "tags": {
                "$(TagPrefix)nanoserver-1809-amd64": {},
                "$(TagPrefix)nanoserver-1809-amd64-$(UniqueId)": {}
              }
            },
            {
              "buildArgs": {
                "WINDOWS_BASE": "nanoserver:ltsc2022-amd64",
                "WINDOWS_SDK": "nanoserver-ltsc2022"
              },
              "dockerfile": "Dockerfile.windows",
              "os": "windows",
              "osVersion": "nanoserver-ltsc2022",
              "tags": {
                "$(TagPrefix)nanoserver-ltsc2022-amd64": {},
                "$(TagPrefix)nanoserver-ltsc2022-amd64-$(UniqueId)": {}
              }
            }
          ]
        }
      ]
    }
  ]
}
