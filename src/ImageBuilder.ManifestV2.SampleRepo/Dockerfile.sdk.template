{% assign sdk = dotnet[version.minor].sdk -%}
{% assign download = sdk.downloads[downloadKey] -%}
{% assign file = download.url | split: "/" | last -%}
{% assign checksumFile = download.checksumUrl | split: "/" | last -%}
{% assign powershell = dotnet[version.minor].powershell -%}
{% assign powershellDownload = powershell.downloads[downloadKey] -%}
{% assign powershellFile = powershellDownload.url | split: "/" | last -%}
{% assign powershellFileSuffix = "." | append: powershell.version | append: ".nupkg" -%}
{% assign powershellPackage = powershellFile | remove: powershellFileSuffix -%}
# Installer image
FROM {{ arch }}/buildpack-deps:{{ os.name }}-curl AS installer

# Install .NET SDK
RUN curl --fail --show-error --location \
        --remote-name {{ download.url }} \
        --remote-name {{ download.checksumUrl }} \
    && sha512sum -c {{ checksumFile }} \
    && mkdir --parents /dotnet \
    && tar --gzip --extract --no-same-owner --file {{ file }} --directory /dotnet ./dnx ./packs ./sdk ./sdk-manifests ./templates ./LICENSE.txt ./ThirdPartyNotices.txt \
    && rm \
        {{ file }} \
        {{ checksumFile }}

# Download PowerShell
RUN curl --fail --show-error --location --output {{ powershellFile }} {{ powershellDownload.url }} \
    && echo "{{ powershellDownload.digest | remove: "sha256:" }}  {{ powershellFile }}" | sha256sum -c -


# .NET SDK image
FROM mcr.microsoft.com/dotnet/aspnet:{{ dotnet[version.minor].aspnet.patch }}-{{ os.name }}-{{ arch }}

ENV \
    # Do not generate certificate
    DOTNET_GENERATE_ASPNET_CERTIFICATE=false \
    # Do not show first run text
    DOTNET_NOLOGO=true \
    # SDK version
    DOTNET_SDK_VERSION={{ sdk.patch }} \
    # Enable correct mode for dotnet watch (only mode supported in a container)
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    # Skip extraction of XML docs - generally not useful within an image/container - helps performance
    NUGET_XMLDOC_MODE=skip \
    # PowerShell telemetry for docker image usage
    POWERSHELL_DISTRIBUTION_CHANNEL=PSDocker-DotnetSDK-{{ os.displayName | replace: " ", "-" }}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        libatomic1 \
        wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=installer ["/dotnet", "/usr/share/dotnet"]

COPY --from=installer ["/{{ powershellFile }}", "/"]

RUN ln -s /usr/share/dotnet/dnx /usr/bin/dnx \
    # Trigger first run experience by running arbitrary cmd
    && dotnet help

# Install PowerShell global tool
RUN mkdir --parents /usr/share/powershell \
    && dotnet tool install --add-source / --tool-path /usr/share/powershell --version {{ powershell.version }} {{ powershellPackage }} \
    && dotnet nuget locals all --clear \
    && rm {{ powershellFile }} \
    && ln -s /usr/share/powershell/pwsh /usr/bin/pwsh \
    && chmod 755 /usr/share/powershell/pwsh \
    && chmod 755 /usr/share/powershell/.store/{{ powershellPackage | downcase }}/{{ powershell.version }}/{{ powershellPackage | downcase }}/{{ powershell.version }}/tools/*/any/pwsh \
    # To reduce image size, remove the copy nupkg that nuget keeps.
    && find /usr/share/powershell -print | grep -i '.*[.]nupkg$' | xargs rm
