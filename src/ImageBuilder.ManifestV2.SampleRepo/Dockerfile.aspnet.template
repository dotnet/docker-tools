{% assign aspnet = release.aspnet -%}
{% assign url = aspnet.downloads[rid].downloadUrl | replace: aspnet.buildVersion, "$aspnetcore_version" -%}
{% assign checksumUrl = aspnet.downloads[rid].sha512Url | replace: aspnet.buildVersion, "$aspnetcore_version" -%}
{% assign file = url | split: "/" | last -%}
{% assign checksumFile = checksumUrl | split: "/" | last -%}
ARG REPO=mcr.microsoft.com/dotnet/runtime

# Installer image
FROM {{ arch }}/buildpack-deps:{{ installerOs }}-curl AS installer

# Retrieve ASP.NET Core
RUN aspnetcore_version={{ aspnet.buildVersion }} \
    && curl --fail --show-error --location \
        --remote-name {{ url }} \
        --remote-name {{ checksumUrl }} \
    && sha512sum -c {{ checksumFile }} \
    && mkdir --parents /dotnet \
    && tar --gzip --extract --no-same-owner --file {{ file }} --directory /dotnet ./shared/Microsoft.AspNetCore.App \
    && rm \
        {{ file }} \
        {{ checksumFile }}


# ASP.NET Core image
FROM $REPO:{{ release.runtime.productVersion }}-{{ os.name }}-{{ arch }}

# ASP.NET Core version
ENV ASPNET_VERSION={{ aspnet.buildVersion }}

COPY --from=installer ["/dotnet", "/usr/share/dotnet"]
